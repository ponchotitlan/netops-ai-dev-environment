{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["github"],
  "permissions": {
    "allow": [
      "Bash(make -C /workspace-tools compile)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(robot:*)",
      "Bash(ncs-make-package:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git remote get-url:*)",
      "mcp__github__get_me",
      "mcp__github__list_issues",
      "mcp__github__search_issues",
      "mcp__github__issue_read",
      "mcp__github__list_issue_types",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__list_branches",
      "mcp__github__list_commits",
      "mcp__github__get_file_contents",
      "mcp__github__projects_list",
      "mcp__github__projects_get"
    ],
    "ask": [
      "Bash(ncs_cli:*)",
      "Bash(ncs_load:*)",
      "Bash(ncs-netsim:*)",
      "Bash(make -C /workspace-tools preconfig-reload)",
      "Bash(make -C /workspace-tools topology)",
      "Bash(make -C /workspace-tools init)",
      "mcp__github__issue_write",
      "mcp__github__add_issue_comment",
      "mcp__github__sub_issue_write",
      "mcp__github__create_branch",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__projects_write",
      "mcp__github__create_or_update_file",
      "mcp__github__push_files",
      "mcp__github__delete_file"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_package_naming.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_edit.py",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
