{
  "name": "NetAuto Dev Environment",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose-override.yml"
  ],
  "service": "dev-main",
  "workspaceFolder": "/nso/run/packages",
  "shutdownAction": "none",
  "onCreateCommand": "make -C /workspace-tools wait-ready",
  "postCreateCommand": "make -C /workspace-tools init claude-code",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        // Claude Code: CLAUDE.md from /nso/run, settings/skills/agents/hooks from /root/.claude
        // (docker-compose-override.yml), github MCP server registered by `make claude-code`
        "anthropic.claude-code",
        // Python language support (IntelliSense, debugging, test discovery). In VS Code it pulls in
        // Pylance; VS Code forks (Cursor, Windsurf) use their own Pyright-based server instead
        "ms-python.python",
        // Python linter and formatter based on Ruff (replaces flake8, isort, black)
        "charliermarsh.ruff",
        // YAML language support with schema validation
        "redhat.vscode-yaml",
        // Robot Framework language support: syntax highlighting, code completion, test execution and debugging
        "d-biehl.robotcode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.ruff": "always",
          "source.organizeImports.ruff": "always"
        },
        // Default = Pylance in VS Code, the editor's own server elsewhere
        "python.languageServer": "Default",
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.autoImportCompletions": true,
        "python.analysis.diagnosticMode": "workspace",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python-envs.defaultEnvManager": "ms-python.python:system"
      }
    }
  }
}
